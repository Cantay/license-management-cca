<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_license_term_form" model="ir.ui.view">
        <field name="name">license.term.form</field>
        <field name="model">license.term</field>
        <field name="arch" type="xml">
            <form string="License Term">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., 1 Year Standard"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="duration" string="Term Duration"/>
                            <div class="o_row">
                                <field name="duration"/>
                                <field name="unit"/>
                            </div>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Subscription Integration">
                         <field name="subscription_template_id"/>
                    </group>
                    <group>
                        <group string="Warning Settings">
                            <field name="warning_days"/>
                            <field name="urgent_warning_days"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_license_term_list" model="ir.ui.view">
        <field name="name">license.term.list</field>
        <field name="model">license.term</field>
        <field name="arch" type="xml">
            <list string="License Terms">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="duration"/>
                <field name="warning_days" optional="show"/>
                <field name="urgent_warning_days" optional="show"/>
                <field name="unit"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>


</odoo>
