<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_license_program_list" model="ir.ui.view">
        <field name="name">license.program.list</field>
        <field name="model">license.program</field>
        <field name="arch" type="xml">
            <list string="License Programs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="product_count"/>
                <field name="license_count"/>
                <field name="active_license_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_license_program_form" model="ir.ui.view">
        <field name="name">license.program.form</field>
        <field name="model">license.program</field>
        <field name="arch" type="xml">
            <form string="License Program">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            invisible="active" bg_color="bg-danger"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object"
                                class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo"
                                   string="Products"/>
                        </button>
                        <button name="action_view_licenses" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <field name="license_count" widget="statinfo"
                                   string="Licenses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Program Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="product_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Add a description..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_license_program_search" model="ir.ui.view">
        <field name="name">license.program.search</field>
        <field name="model">license.program</field>
        <field name="arch" type="xml">
            <search string="Search Programs">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Active" name="active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>


</odoo>
