<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_license_renewal_wizard" model="ir.ui.view">
        <field name="name">license.renewal.wizard.form</field>
        <field name="model">license.renewal.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew License">
                <group>
                    <field name="license_id" invisible="1"/>
                    <field name="customer_id"/>
                    <field name="dealer_id"/>
                    <field name="product_id" domain="[('is_license_product', '=', True)]"/>
                    <field name="license_term_id" options="{'no_create_edit': True}"/>
                    <field name="start_date"/>
                    <field name="duration"/>
                    <field name="end_date"/>
                    <field name="amount"/>
                </group>
                <group string="Notes">
                    <field name="notes" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_renew" string="Renew"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
