<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="ir_cron_update_license_states" model="ir.cron">
            <field name="name">License: Update States Daily</field>
            <field name="model_id" ref="model_license_subscription"/>
            <field name="state">code</field>
            <!-- Yeni oluşturduğumuz Python metodunu çağırıyoruz -->
            <field name="code">model._cron_update_license_states()</field>
            <field name="interval_type">days</field>
            <!-- Bu cron'un e-posta gönderen cron'dan önce çalışması iyi olur.
                 Düşük öncelik numarası daha önce çalışmasını sağlar. -->
            <field name="priority">5</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_check_expiring_licenses" model="ir.cron">
            <field name="name">Check Expiring Licenses</field>
            <field name="model_id" ref="model_license_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiring_licenses()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
</odoo>
