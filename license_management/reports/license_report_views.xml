<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- License Report Action -->
    <record id="action_license_report" model="ir.actions.act_window">
        <field name="name">License Report</field>
        <field name="res_model">license.subscription</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{
            'search_default_group_partner': 1,
            'search_default_group_state': 1,
        }</field>
    </record>

    <menuitem id="menu_license_reports"
              name="Reports"
              parent="menu_license_root"
              sequence="80"/>

    <menuitem id="menu_license_analysis"
              name="License Analysis"
              parent="menu_license_reports"
              action="action_license_report"
              sequence="10"/>

    <!-- Expiring Licenses Report -->
    <record id="action_expiring_licenses_report" model="ir.actions.act_window">
        <field name="name">Expiring Licenses</field>
        <field name="res_model">license.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'expiring')]</field>
        <field name="context">{'search_default_group_end_date': 1}</field>
    </record>

    <menuitem id="menu_expiring_licenses"
              name="Expiring Licenses"
              parent="menu_license_reports"
              action="action_expiring_licenses_report"
              sequence="20"/>
</odoo>
