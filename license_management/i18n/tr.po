#. module: license_management
#: model:mail.template,body_html:license_management.mail_template_license_expiring
msgid ""
"<p>Dear {{ object.partner_id.name }},</p>\n"
"<p>Your license <strong>{{ object.license_no }}</strong> for {{ object."
"product_id.name }}\n"
"will expire on <strong>{{ object.end_date }}</strong> ({{ object."
"days_to_expire }} days remaining).</p>\n"
"<p>Please contact us to renew your license.</p>\n"
"<p>Best regards,<br/>{{ user.company_id.name }}</p>\n"
"            "
msgstr ""
"<p>Sayın {{ object.customer_id.name }},</p>\n"
"<p>Kullanmakta olduğunuz <strong>{{ object.product_id.name }}</strong> "
"ürününe ait <strong>{{ object.license_no }}</strong> numaralı lisansınızın "
"geçerlilik süresi, <strong>{{ object.end_date }}</strong> tarihinde "
"dolacaktır. (Kalan Süre: {{ object.days_to_expire }} gün)</p>\n"
"<p>Hizmetlerinizde herhangi bir kesinti yaşanmaması için lisansınızı "
"yenilemek üzere lütfen bayiniz ile iletişime geçmenizi rica ederiz.</p>\n"
"<p>Saygılarımızla,<br/>{{ user.company_id.name }}</p>"

