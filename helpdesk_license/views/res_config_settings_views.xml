<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_helpdesk_license" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.helpdesk.license</field>
        <field name="model">res.config.settings</field>
        <!-- Burası önemli: Doğrudan helpdesk_mgmt ayarlarını genişletiyoruz -->
        <field name="inherit_id" ref="helpdesk_mgmt.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Helpdesk app'inin içine yeni bir blok ekliyoruz -->
            <xpath expr="//app[@name='helpdesk_mgmt']" position="inside">

                <block title="Lisans &amp; Bakım Anlaşması Entegrasyonu">
                    <setting help="Bir ticket'a destek hakkı tanınması için bakım anlaşması kontrolünün nasıl yapılacağını belirler.">
                        <div>
                            <field name="check_maintenance_on_partner_licenses"/>
                            <label for="check_maintenance_on_partner_licenses" string="Müşterinin Tüm Lisanslarını Kontrol Et"/>
                        </div>
                        <div class="text-muted ps-3">
                            Bu seçenek aktifken, bir ticket'ta belirli bir lisans seçilmese bile, eğer müşterinin aktif ve bakım anlaşmalı başka bir lisansı varsa ticket'a destek hakkı tanınır.
                        </div>
                    </setting>
                </block>

            </xpath>
        </field>
    </record>
</odoo>
