<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dashboard_helpdesk" model="spreadsheet.dashboard">
        <field name="name">Helpdesk Tickets</field>
        <field name="spreadsheet_binary_data" type="base64" file="spreadsheet_dashboard_helpdesk/data/files/helpdesk_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('helpdesk_mgmt.model_helpdesk_ticket'))]"/>
        <field name="sample_dashboard_file_path">spreadsheet_dashboard_helpdesk/data/files/helpdesk_sample_dashboard.json</field>
        <field name="dashboard_group_id" eval="8"/>
        <field name="sequence">70</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_helpdesk_performance" model="spreadsheet.dashboard">
        <field name="name">Helpdesk Performance</field>
        <field name="spreadsheet_binary_data" type="base64" file="spreadsheet_dashboard_helpdesk/data/files/helpdesk_performance_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('helpdesk_mgmt.model_helpdesk_ticket'))]"/>
        <field name="dashboard_group_id" eval="8"/>
        <field name="sequence">71</field>
        <field name="is_published">True</field>
    </record>

    <record id="dashboard_license_health" model="spreadsheet.dashboard">
        <field name="name">License Health</field>
        <field name="spreadsheet_binary_data" type="base64" file="spreadsheet_dashboard_helpdesk/data/files/license_health_dashboard.json"/>
        <field name="main_data_model_ids" eval="[(4, ref('license_management.model_license_subscription'))]"/>
        <field name="dashboard_group_id" eval="8"/>
        <field name="sequence">72</field>
        <field name="is_published">True</field>
    </record>
</odoo>
